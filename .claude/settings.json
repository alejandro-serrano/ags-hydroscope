{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(python -m hydroscope.training.evaluate *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(nvidia-smi)",
      "Bash(npm run lint *)",
      "Bash(npm run test *)",
      "Bash(npm run build)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(python -m hydroscope.training.train *)",
      "Bash(python -m hydroscope.training.finetune *)",
      "Bash(python -m hydroscope.geo.gee_export *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(/experiments/results/**)",
      "Bash(git push --force *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-python.sh"
          }
        ]
      }
    ]
  }
}
